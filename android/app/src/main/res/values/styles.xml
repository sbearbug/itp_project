<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/app_background</item>
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Graphite" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_graphite_background</item>
        <item name="windowSplashScreenBackground">@color/theme_graphite_background</item>
        <item name="android:statusBarColor">@color/theme_graphite_background</item>
        <item name="android:navigationBarColor">@color/theme_graphite_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.IceDark" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_ice_dark_background</item>
        <item name="windowSplashScreenBackground">@color/theme_ice_dark_background</item>
        <item name="android:statusBarColor">@color/theme_ice_dark_background</item>
        <item name="android:navigationBarColor">@color/theme_ice_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Ice" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_ice_background</item>
        <item name="windowSplashScreenBackground">@color/theme_ice_background</item>
        <item name="android:statusBarColor">@color/theme_ice_background</item>
        <item name="android:navigationBarColor">@color/theme_ice_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Moss" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_moss_background</item>
        <item name="windowSplashScreenBackground">@color/theme_moss_background</item>
        <item name="android:statusBarColor">@color/theme_moss_background</item>
        <item name="android:navigationBarColor">@color/theme_moss_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Sunny" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_sunny_background</item>
        <item name="windowSplashScreenBackground">@color/theme_sunny_background</item>
        <item name="android:statusBarColor">@color/theme_sunny_background</item>
        <item name="android:navigationBarColor">@color/theme_sunny_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Mist" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/theme_mist_background</item>
        <item name="windowSplashScreenBackground">@color/theme_mist_background</item>
        <item name="android:statusBarColor">@color/theme_mist_background</item>
        <item name="android:navigationBarColor">@color/theme_mist_background</item>
    </style>
</resources>
